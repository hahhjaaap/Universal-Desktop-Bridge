include LICENSE README.md
include examples/config/udb.example.toml examples/config/MCP_CONFIGURATION.example.json
recursive-include src/udb *.ps1
recursive-include tools *.py *.spec
prune state
prune vendor
prune vendor-office

include _udb_compat.py bridge.py
include udb_background.py udb_companion.py udb_documents.py udb_unified.py
# Keep regression suites on GitHub; exclude them from customer source archives.
prune tests
include plugin.json

include install.ps1
