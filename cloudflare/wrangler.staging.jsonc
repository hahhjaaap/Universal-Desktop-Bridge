{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "udb-private-relay-staging",
  "main": "src/index.js",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  // Staging-only binding. MCP authorization remains on legacy grants until
  // UDB_TENANT_D1_AUTH is set to the exact string "true" after acceptance tests.
  // D1's schema was initially applied through Cloudflare API; reconcile the
  // Wrangler migration ledger before running wrangler d1 migrations apply.
  "d1_databases": [
    {
      "binding": "UDB_TENANT_DB",
      "database_name": "udb-auth-staging",
      "database_id": "fd474b23-56be-44c7-8387-615a071de824",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "DEVICES", "class_name": "DeviceRelay" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DeviceRelay"] }
  ]
}
